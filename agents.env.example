# Independent 0.5.0 stack. Set UID/GID from id -u / id -g on macOS/Linux.
AGENTS_UID=1000
AGENTS_GID=1000
AGENTS_DATA_DIR=./.agent-data
# Optional: the exact public HTTPS origin of an explicitly authorized tunnel.
# Leave empty for local-only operation; never use a wildcard or the /mcp path.
RAG_PUBLIC_ORIGIN=
